<Window x:Class="VpnUs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VpnUs.App.ViewModels"
        xmlns:views="clr-namespace:VpnUs.App.Views"
        Title="VpnUs" Width="1180" Height="840" MinWidth="980" MinHeight="640"
        Icon="Assets/icon.png"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServersViewModel}">
            <views:ServersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppsViewModel}">
            <views:AppsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#E60B0C10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#6614161C" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,22">
                    <Image Source="Assets/icon.png" Width="34" Height="34"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="VpnUs" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="sing-box · per-app" Style="{StaticResource Caption}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1" Style="{StaticResource NavList}"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" />
                                <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <!-- Быстрое подключение из боковой панели -->
                    <Button Command="{Binding Home.ToggleCommand}" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{Binding Home.ConnectButtonText}"
                            ToolTip="{Binding Home.ConnectButtonHint}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Padding" Value="12,10" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Home.StateKind}" Value="connected">
                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessSoftBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Home.StateKind}" Value="connecting">
                                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningSoftBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Home.StateKind}" Value="error">
                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DangerSoftBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Home.StateKind}" Value="connected">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Home.StateKind}" Value="connecting">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Home.StateKind}" Value="error">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding Home.StatusLabel}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Home.DownSpeed, StringFormat=↓ {0}}" Style="{StaticResource Caption}"
                                           FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <TextBlock Text="{Binding ServiceStatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Margin="6,12,6,0" FontSize="11.5" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" FontSize="10.5"
                               Margin="6,4,6,0" Opacity="0.7" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding Current}" />
    </Grid>
</Window>
