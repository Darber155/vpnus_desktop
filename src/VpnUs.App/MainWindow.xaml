<Window x:Class="VpnUs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VpnUs.App.ViewModels"
        xmlns:views="clr-namespace:VpnUs.App.Views"
        Title="VpnUs" Width="1180" Height="840" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServersViewModel}">
            <views:ServersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppsViewModel}">
            <views:AppsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#E60B0C10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#6614161C" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,22">
                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentGradientBrush}">
                        <TextBlock Text="V" FontWeight="Bold" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="VpnUs" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="sing-box · per-app" Style="{StaticResource Caption}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1" Style="{StaticResource NavList}"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" />
                                <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="6,14,6,0">
                    <TextBlock Text="{Binding ServiceStatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <TextBlock Text="Данные не покидают машину" Style="{StaticResource Caption}" FontSize="10.5"
                               Margin="0,6,0,0" Opacity="0.7" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding Current}" />
    </Grid>
</Window>
