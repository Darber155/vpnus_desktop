<UserControl x:Class="VpnUs.App.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VpnUs.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:DelayToBrushConverter x:Key="DelayToBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

        <Style x:Key="ServerRow" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" CornerRadius="12" Padding="12,10" Margin="0,0,0,8"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Серверы" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding SelectedName, StringFormat=Выбран: {0}}" Style="{StaticResource Caption}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         Padding="34,8,28,8" AutomationProperties.Name="Поиск сервера" />
                <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="13" Margin="12,0,0,0"
                           IsHitTestVisible="False" />
                <TextBlock Text="Поиск по стране, адресу или протоколу" Foreground="{StaticResource TextMutedBrush}"
                           Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding ElementName=FilterBox, Path=Text, Converter={StaticResource NullToVisibility}, ConverterParameter=empty}" />
                <Button Command="{Binding ClearFilterCommand}" Style="{StaticResource GhostButton}"
                        Padding="0" Width="22" Height="22" HorizontalAlignment="Right" Margin="0,0,5,0"
                        ToolTip="Очистить поиск" AutomationProperties.Name="Очистить поиск"
                        Visibility="{Binding Filter, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" Foreground="{StaticResource TextBrush}"
                           Visibility="{Binding Status, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>

            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                    Command="{Binding TestAllCommand}" IsEnabled="{Binding TunnelRunning}" ToolTip="{Binding Hint}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Проверить все" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock Text="Подписка пуста. Укажите URL подписки в «Настройках» и обновите её."
                       Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="0,20,0,0"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource ServerRow}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Flag}" FontSize="20" VerticalAlignment="Center"
                                       Visibility="{Binding HasFlag, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Endpoint}" Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource Chip}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TypeLabel}" FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </Border>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"
                                         Fill="{Binding Delay, Converter={StaticResource DelayToBrush}}" />
                                <TextBlock Text="{Binding DelayText}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{Binding Delay, Converter={StaticResource DelayToBrush}}" />
                            </StackPanel>

                            <Button Grid.Column="4" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Проверить задержку"
                                    AutomationProperties.Name="Проверить задержку"
                                    Command="{Binding DataContext.TestOneCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                            </Button>

                            <TextBlock Grid.Column="5" Text="&#xE73E;" Style="{StaticResource IconText}"
                                       FontSize="15" Foreground="{StaticResource SuccessBrush}"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
