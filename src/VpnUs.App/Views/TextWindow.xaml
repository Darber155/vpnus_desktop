<Window x:Class="VpnUs.App.Views.TextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Текст" Width="820" Height="640" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Style="{StaticResource SectionTitle}" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <TextBox x:Name="BodyText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12.5"
                     Background="Transparent" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Сохранить в файл" Style="{StaticResource SecondaryButton}" Click="OnSaveClick" />
            <Button Content="Закрыть" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
