<UserControl x:Class="VpnUs.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VpnUs.App.Controls">
    <UserControl.Resources>
        <Style x:Key="HeroStat" TargetType="Border" BasedOn="{StaticResource StatTile}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="13,10" />
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ServerChipButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,28">
            <!-- Заголовок -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Главная" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding SubscriptionLabel}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <Border Grid.Column="1" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                            <Setter Property="Padding" Value="11,5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StateKind}" Value="connected">
                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessSoftBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StateKind}" Value="connecting">
                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource WarningSoftBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StateKind}" Value="error">
                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerSoftBorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StateKind}" Value="connected">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKind}" Value="connecting">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKind}" Value="error">
                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ошибки/состояние службы -->
            <Border Style="{StaticResource Card}" Background="{StaticResource DangerSoftBrush}"
                    BorderBrush="{StaticResource DangerSoftBorderBrush}" Padding="14" Margin="0,0,0,14"
                    Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE783;" Style="{StaticResource IconText}" Foreground="{StaticResource DangerBrush}"
                               VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="Логи" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                            Command="{Binding OpenLogsCommand}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Background="{StaticResource WarningSoftBrush}"
                    BorderBrush="{StaticResource WarningSoftBorderBrush}" Padding="14" Margin="0,0,0,14"
                    Visibility="{Binding ServiceIssue, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding ServiceIssueText}" TextWrapping="Wrap"
                               Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="Открыть настройки" Style="{StaticResource SecondaryButton}"
                            Margin="12,0,0,0" Command="{Binding OpenSettingsCommand}" />
                </Grid>
            </Border>

            <!-- Герой: подключение -->
            <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Border CornerRadius="16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource HeroGlowBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StateKind}" Value="connected">
                                        <Setter Property="Background" Value="{StaticResource HeroGlowConnectedBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateKind}" Value="error">
                                        <Setter Property="Background" Value="{StaticResource HeroGlowErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Grid Margin="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Command="{Binding ToggleCommand}" Cursor="Hand" Width="176" Height="176"
                                AutomationProperties.Name="{Binding ConnectButtonText}"
                                ToolTip="{Binding ConnectButtonHint}"
                                FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="Pulse" Stroke="{StaticResource WarningBrush}" StrokeThickness="2"
                                                 Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse x:Name="Ring" StrokeThickness="1.5"
                                                 Stroke="{StaticResource BorderStrongBrush}" />
                                        <Ellipse x:Name="Circle" Margin="10" Fill="{StaticResource AccentGradientBrush}" />
                                        <Ellipse Margin="16" Opacity="0.18" IsHitTestVisible="False">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush Center="0.35,0.25" GradientOrigin="0.35,0.25"
                                                                     RadiusX="0.7" RadiusY="0.7">
                                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="27"
                                                       Foreground="White" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding ConnectButtonText}" FontSize="15" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding ConnectButtonHint}" FontSize="10.5"
                                                       Foreground="#CCFFFFFF" HorizontalAlignment="Center" Margin="0,3,0,0"
                                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="124" />
                                        </StackPanel>
                                        <Ellipse x:Name="FocusRing" Margin="-4" StrokeThickness="2"
                                                 Stroke="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding StateKind}" Value="connected">
                                            <Setter TargetName="Circle" Property="Fill" Value="{StaticResource ConnectGradientBrush}" />
                                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource SuccessSoftBorderBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKind}" Value="error">
                                            <Setter TargetName="Circle" Property="Fill" Value="{StaticResource ErrorGradientBrush}" />
                                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DangerSoftBorderBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKind}" Value="connecting">
                                            <Setter TargetName="Circle" Property="Fill" Value="{StaticResource ConnectingGradientBrush}" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="PulseStory">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="PulseScale"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         From="0.9" To="1.06" Duration="0:0:1.1" />
                                                        <DoubleAnimation Storyboard.TargetName="PulseScale"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         From="0.9" To="1.06" Duration="0:0:1.1" />
                                                        <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                                                         From="0.9" To="0" Duration="0:0:1.1" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="PulseStory" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Circle" Property="Opacity" Value="0.9" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Circle" Property="Opacity" Value="0.78" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusLabel}" FontSize="29" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusHint}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                       FontSize="12.5" />

                            <UniformGrid Columns="4" Margin="0,18,0,0">
                                <Border Style="{StaticResource HeroStat}">
                                    <StackPanel>
                                        <TextBlock Text="↓ Скачивание" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding DownSpeed}" Style="{StaticResource StatValue}"
                                                   Foreground="{StaticResource SuccessBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HeroStat}">
                                    <StackPanel>
                                        <TextBlock Text="↑ Отдача" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding UpSpeed}" Style="{StaticResource StatValue}"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HeroStat}">
                                    <StackPanel>
                                        <TextBlock Text="VPN ↓ всего" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding TotalDown}" Style="{StaticResource StatValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}" Padding="13,10">
                                    <StackPanel>
                                        <TextBlock Text="VPN ↑ всего" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding TotalUp}" Style="{StaticResource StatValue}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshSubscriptionCommand}"
                                        IsEnabled="{Binding Main.IsRefreshingSubscription, Converter={StaticResource InverseBool}}"
                                        AutomationProperties.Name="Обновить подписку">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Обновить подписку" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Main.IsRefreshingSubscription}" Value="True">
                                                            <Setter Property="Text" Value="Обновляю…" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LastUpdateLabel}" Style="{StaticResource Caption}"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding CoreLabel}" Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Трафик + сессия -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Трафик" Style="{StaticResource SectionTitle}" Margin="0,0,0,1" />
                                <TextBlock Text="{Binding TrafficRangeLabel}" Style="{StaticResource Caption}" FontSize="11.5" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="↓" FontSize="11" Foreground="{StaticResource SuccessBrush}" />
                                    <TextBlock Text="{Binding DownSpeed}" FontSize="12.5" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="↑" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding UpSpeed}" FontSize="12.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,8,0,4" MinHeight="148">
                            <controls:TrafficChart DownValues="{Binding DownSamples}" UpValues="{Binding UpSamples}"
                                                   DownBrush="{StaticResource SuccessBrush}"
                                                   UpBrush="{StaticResource AccentBrush}"
                                                   GridBrush="{StaticResource ChartGridBrush}"
                                                   TextBrush="{StaticResource TextMutedBrush}"
                                                   EmptyText="" Height="148" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                           Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Нет данных о трафике" FontWeight="SemiBold" FontSize="13"
                                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="Подключитесь, чтобы видеть скорость" Style="{StaticResource Caption}"
                                           FontSize="11.5" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Пик ↓" Style="{StaticResource StatLabel}" FontSize="10.5" />
                                <TextBlock Text="{Binding PeakDownLabel}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Пик ↑" Style="{StaticResource StatLabel}" FontSize="10.5" />
                                <TextBlock Text="{Binding PeakUpLabel}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Соединений" Style="{StaticResource StatLabel}" FontSize="10.5" />
                                <TextBlock Text="{Binding ConnectionsValue}" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Текущая сессия" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CountryBadge}">
                                <Grid>
                                    <TextBlock Text="{Binding ServerCode}" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentBrush}"
                                               Visibility="{Binding ServerIsAuto, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource WarningBrush}"
                                               Visibility="{Binding ServerIsAuto, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ServerName}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource Caption}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Сменить" Style="{StaticResource LinkButton}"
                                    Command="{Binding OpenServersCommand}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Приложения" Style="{StaticResource DetailLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding AppsLabel}" Style="{StaticResource DetailValue}"
                                       Margin="12,0,0,0" />
                            <TextBlock Grid.Row="1" Text="Время" Style="{StaticResource DetailLabel}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Uptime}" Style="{StaticResource DetailValue}"
                                       Margin="12,8,0,0" />
                            <TextBlock Grid.Row="2" Text="Соединений" Style="{StaticResource DetailLabel}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConnectionsValue}"
                                       Style="{StaticResource DetailValue}" Margin="12,8,0,0" />
                            <TextBlock Grid.Row="3" Text="Подписка" Style="{StaticResource DetailLabel}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastUpdateLabel}"
                                       Style="{StaticResource Caption}" FontSize="11.5" TextAlignment="Right"
                                       Margin="12,8,0,0" />
                        </Grid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Настроить приложения" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenAppsCommand}" />
                            <Button Content="Логи" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding OpenLogsCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Быстрый выбор сервера -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16"
                    Visibility="{Binding HasQuickServers, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Быстрый выбор" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Text="· серверов в подписке" Style="{StaticResource Caption}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Все серверы" Style="{StaticResource LinkButton}"
                                Command="{Binding OpenServersCommand}" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding QuickServers}" Margin="0,10,0,-8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ServerChipButton}"
                                        Command="{Binding DataContext.SelectServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="#14FFFFFF"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="{Binding CountryCode}" FontSize="8.5" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Visibility="{Binding HasCountryCode, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           Visibility="{Binding IsAuto, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Margin="8,0,0,0" MaxWidth="150"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
