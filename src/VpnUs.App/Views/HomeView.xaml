<UserControl x:Class="VpnUs.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Главная" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding SubscriptionLabel}" Style="{StaticResource Caption}" />
                </StackPanel>

                <!-- Пилюля состояния -->
                <Border Grid.Column="1" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StateKind}" Value="connected">
                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessSoftBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StateKind}" Value="connecting">
                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource WarningSoftBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StateKind}" Value="error">
                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerSoftBorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StateKind}" Value="connected">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKind}" Value="connecting">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKind}" Value="error">
                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusLabel}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Background="{StaticResource DangerSoftBrush}"
                    BorderBrush="{StaticResource DangerSoftBorderBrush}" Padding="14" Margin="0,0,0,16"
                    Visibility="{Binding Error, Converter={StaticResource NullToVisibility}, ConverterParameter=null}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE783;" Style="{StaticResource IconText}" Foreground="{StaticResource DangerBrush}"
                               VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}" />
                </Grid>
            </Border>

            <!-- Герой: кнопка подключения + статус -->
            <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Border CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource HeroGlowBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StateKind}" Value="connected">
                                        <Setter Property="Background" Value="{StaticResource HeroGlowConnectedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Grid Margin="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Command="{Binding ToggleCommand}" Cursor="Hand" Width="200" Height="200"
                                AutomationProperties.Name="{Binding ConnectButtonText}"
                                ToolTip="{Binding ConnectButtonHint}"
                                FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <!-- Пульсирующее кольцо (видно при подключении) -->
                                        <Ellipse x:Name="Pulse" Stroke="{StaticResource WarningBrush}" StrokeThickness="2"
                                                 Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse x:Name="Ring" Margin="0" StrokeThickness="2"
                                                 Stroke="{StaticResource BorderStrongBrush}" />
                                        <Ellipse x:Name="Circle" Margin="12" Fill="{StaticResource AccentGradientBrush}" />
                                        <Ellipse Margin="18" Opacity="0.2" IsHitTestVisible="False">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush Center="0.35,0.25" GradientOrigin="0.35,0.25" RadiusX="0.7" RadiusY="0.7">
                                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                                       Foreground="White" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding ConnectButtonText}" FontSize="16" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                            <TextBlock Text="{Binding ConnectButtonHint}" FontSize="11" Foreground="#CCFFFFFF"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       TextAlignment="Center" MaxWidth="140" />
                                        </StackPanel>
                                        <Ellipse x:Name="FocusRing" Margin="-4" StrokeThickness="2"
                                                 Stroke="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding StateKind}" Value="connected">
                                            <Setter TargetName="Circle" Property="Fill" Value="{StaticResource ConnectGradientBrush}" />
                                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource SuccessSoftBorderBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKind}" Value="error">
                                            <Setter TargetName="Circle" Property="Fill" Value="{StaticResource ErrorGradientBrush}" />
                                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DangerSoftBorderBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKind}" Value="connecting">
                                            <Setter TargetName="Circle" Property="Fill" Value="{StaticResource ConnectingGradientBrush}" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="PulseStory">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX"
                                                                         From="0.9" To="1.08" Duration="0:0:1.1" />
                                                        <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY"
                                                                         From="0.9" To="1.08" Duration="0:0:1.1" />
                                                        <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                                                         From="0.9" To="0" Duration="0:0:1.1" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="PulseStory" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Circle" Property="Opacity" Value="0.9" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Circle" Property="Opacity" Value="0.78" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Circle" Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <StackPanel Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusLabel}" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" />

                            <UniformGrid Columns="4" Margin="0,20,0,0">
                                <Border Style="{StaticResource StatTile}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="↓ Скачивание" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding DownSpeed}" Style="{StaticResource StatValue}"
                                                   Foreground="{StaticResource SuccessBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="↑ Отдача" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding UpSpeed}" Style="{StaticResource StatValue}"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="VPN ↓ всего" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding TotalDown}" Style="{StaticResource StatValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}">
                                    <StackPanel>
                                        <TextBlock Text="VPN ↑ всего" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding TotalUp}" Style="{StaticResource StatValue}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Text="{Binding SystemTotals}" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                       Visibility="{Binding SystemTotals, Converter={StaticResource NullToVisibility}}" />

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshSubscriptionCommand}"
                                        AutomationProperties.Name="Обновить подписку">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Обновить подписку" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LastUpdateLabel}" Style="{StaticResource Caption}"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CoreLabel}" Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Быстрые карточки -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource CardButton}" Command="{Binding OpenServersCommand}"
                        ToolTip="Открыть список серверов" AutomationProperties.Name="Сервер">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoftBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE774;" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Сервер" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding ServerName}" Style="{StaticResource StatValue}" FontSize="15"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource IconText}" FontSize="12" />
                    </Grid>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource CardButton}" Margin="16,0" Command="{Binding OpenAppsCommand}"
                        ToolTip="Настроить приложения и режим" AutomationProperties.Name="Режим">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoftBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE71D;" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Режим" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource StatValue}" FontSize="15"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding AppsLabel}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource IconText}" FontSize="12" />
                    </Grid>
                </Button>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource SuccessSoftBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE916;" Style="{StaticResource IconText}" Foreground="{StaticResource SuccessBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Время работы" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding Uptime}" Style="{StaticResource StatValue}" FontSize="15" />
                            <TextBlock Text="{Binding ConnectionsLabel}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{Binding ConnectionsLabel, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
