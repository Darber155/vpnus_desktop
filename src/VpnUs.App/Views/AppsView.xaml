<UserControl x:Class="VpnUs.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VpnUs.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />

        <Style x:Key="AppRow" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" CornerRadius="10" Padding="10,6" Margin="0,0,0,4"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,18,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Приложения" Style="{StaticResource PageTitle}" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Background="#18FFB020" BorderBrush="#44FFB020"
                Padding="12,8" Margin="0,4,0,10">
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource WarningBrush}"
                       Text="Split tunneling работает по процессу-владельцу соединения: службы Windows, антивирус, процессы других пользователей и UWP могут не попадать под правила." />
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="Режим маршрутизации" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding SelectedMode.Description}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ModeWarning}" TextWrapping="Wrap" Margin="0,8,0,0"
                               FontSize="12.5" Foreground="{StaticResource WarningBrush}"
                               Visibility="{Binding ModeWarning, Converter={StaticResource NullToVisibility}, ConverterParameter=null}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="Режим выбора приложений" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <RadioButton GroupName="AppSplit" Content="Все приложения через VPN (весь трафик в туннель)"
                                 IsChecked="{Binding IsSplitAll, Mode=TwoWay}" />
                    <RadioButton GroupName="AppSplit" Content="Только выбранные (остальные — напрямую)"
                                 IsChecked="{Binding IsSplitOnly, Mode=TwoWay}" />
                    <RadioButton GroupName="AppSplit" Content="Все, кроме выбранных (выбранные — напрямую)"
                                 IsChecked="{Binding IsSplitExcept, Mode=TwoWay}" />
                    <TextBlock Text="Действует в режиме «Только выбранные приложения»."
                               Style="{StaticResource Caption}" FontSize="11.5" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
            <StackPanel>
                <TextBlock Text="Ресурсы через VPN (для режима «Только выбранные ресурсы»)"
                           Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Resources}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="0,0,18,4" FontSize="13" Click="OnRowCheckClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="220">
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Поиск" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding ElementName=SearchBox, Path=Text, Converter={StaticResource NullToVisibility}, ConverterParameter=empty}" />
                </Grid>

                <ComboBox Grid.Column="1" Width="120" Margin="10,0,0,0" ItemsSource="{Binding Sources}"
                          SelectedItem="{Binding SourceFilter, Mode=TwoWay}" />
                <CheckBox Grid.Column="2" Margin="14,0,0,0" Content="Запущенные"
                          IsChecked="{Binding ShowOnlyRunning, Mode=TwoWay}" VerticalAlignment="Center" />
                <CheckBox Grid.Column="3" Margin="14,0,0,0" Content="Выбранные"
                          IsChecked="{Binding ShowOnlySelected, Mode=TwoWay}" VerticalAlignment="Center" />

                <Button Grid.Column="5" Content="Применить" Style="{StaticResource PrimaryButton}"
                        ToolTip="Сохранить список и режим, пересобрать конфиг и перезапустить туннель"
                        Command="{Binding SaveCommand}" IsEnabled="{Binding Dirty, Mode=OneWay}" />
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Обновить список" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                <Button Content="Добавить .exe" Style="{StaticResource SecondaryButton}"
                        Command="{Binding AddManualCommand}" Margin="0,0,8,0" />
                <Button Content="Выбрать видимые" Style="{StaticResource GhostButton}"
                        Command="{Binding SelectVisibleCommand}" />
                <Button Content="Снять выделение" Style="{StaticResource GhostButton}"
                        Command="{Binding ClearSelectionCommand}" Margin="0,0,14,0" />
                <TextBlock Text="{Binding SelectedCount, StringFormat=Выбрано: {0}}"
                           Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,8">

            <ListBox ItemsSource="{Binding Apps}" ItemContainerStyle="{StaticResource AppRow}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="OnRowCheckClick"
                                      VerticalAlignment="Center" />

                            <Image Grid.Column="1" Source="{Binding Icon}" Width="22" Height="22"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PathText}" Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis" FontSize="11.5" />
                            </StackPanel>

                            <Border Grid.Column="3" Style="{StaticResource Chip}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </Border>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" />
                                <TextBlock Text="запущено" Style="{StaticResource Caption}" FontSize="11"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
