<UserControl x:Class="VpnUs.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <UserControl.Resources>
        <Style x:Key="AppRow" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Root" CornerRadius="10" Padding="12,8" Margin="0,0,0,3"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Accent" Width="3" Height="22" CornerRadius="2" Margin="-1,0,0,0"
                                    Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0DFFFFFF" />
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка-переключатель для режима выбора приложений -->
        <Style x:Key="SplitOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="10" Padding="12,9" Margin="0,0,0,6"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Outer" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Center"
                                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1.5">
                                    <Ellipse x:Name="Inner" Width="8" Height="8" Fill="White" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Outer" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Inner" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Чипы ресурсов -->
        <Style x:Key="ResourceChip" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Root" CornerRadius="999" Padding="12,5" Margin="0,0,8,8"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                           Margin="0,0,6,0" Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="12.5" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentSoftBorderBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="30,26,30,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Приложения" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Выберите, какие программы идут через VPN. Можно перетащить .exe или ярлык прямо в окно." />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Center"
                        Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentSoftBorderBrush}"
                        Padding="11,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                 Margin="0,0,7,0" />
                        <TextBlock Text="{Binding SelectionSummary}" FontSize="11.5" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Режимы -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Режим маршрутизации" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                  AutomationProperties.Name="Режим маршрутизации">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding SelectedMode.Description}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningSoftBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,10,0,0"
                                Visibility="{Binding ModeWarning, Converter={StaticResource NullToVisibility}, ConverterParameter=null}">
                            <TextBlock Text="{Binding ModeWarning}" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{StaticResource WarningBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Какие приложения через VPN" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                        <TextBlock Text="Доступно в режиме «Только выбранные приложения»" Style="{StaticResource Caption}"
                                   FontSize="10.5" Margin="0,0,0,4"
                                   Visibility="{Binding IsPerAppMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <StackPanel IsEnabled="{Binding IsPerAppMode}">
                            <RadioButton GroupName="AppSplit" Style="{StaticResource SplitOption}"
                                         IsChecked="{Binding IsSplitOnly, Mode=TwoWay}" Margin="0,6,0,6">
                                <StackPanel>
                                    <TextBlock Text="Только выбранные" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Text="Остальные программы идут напрямую" Style="{StaticResource Caption}"
                                               FontSize="11" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="AppSplit" Style="{StaticResource SplitOption}"
                                         IsChecked="{Binding IsSplitExcept, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Все, кроме выбранных" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Text="Отмеченные программы идут напрямую" Style="{StaticResource Caption}"
                                               FontSize="11" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="AppSplit" Style="{StaticResource SplitOption}"
                                         IsChecked="{Binding IsSplitAll, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Все приложения" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Text="Весь трафик в туннель, список игнорируется" Style="{StaticResource Caption}"
                                               FontSize="11" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ресурсы -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,14,16,6"
                    Visibility="{Binding IsSelectiveMode, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Ресурсы через VPN" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Resources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource ResourceChip}" Content="{Binding Title}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Панель инструментов -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="340" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,30,8"
                                 Tag="Поиск" AutomationProperties.Name="Поиск приложений" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="12" Margin="12,0,0,0"
                                   IsHitTestVisible="False" />
                        <Button Command="{Binding ClearSearchCommand}" Style="{StaticResource GhostButton}"
                                Padding="0" Width="22" Height="22" HorizontalAlignment="Right" Margin="0,0,5,0"
                                ToolTip="Очистить поиск" AutomationProperties.Name="Очистить поиск"
                                Visibility="{Binding Search, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <ComboBox Grid.Column="1" Width="122" Margin="10,0,0,0" ItemsSource="{Binding Sources}"
                              SelectedItem="{Binding SourceFilter, Mode=TwoWay}" AutomationProperties.Name="Источник" />
                    <CheckBox Grid.Column="2" Margin="14,0,0,0" Content="Запущенные"
                              IsChecked="{Binding ShowOnlyRunning, Mode=TwoWay}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="3" Margin="14,0,0,0" Content="Выбранные"
                              IsChecked="{Binding ShowOnlySelected, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding VisibleCount, StringFormat=Показано: {0}}"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconActionButton}" Command="{Binding ScanCommand}"
                                ToolTip="Пересканировать установленные программы">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Обновить" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconActionButton}" Command="{Binding SelectRunningCommand}"
                                ToolTip="Отметить все запущенные сейчас программы">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Запущенные" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconActionButton}" Command="{Binding AddManualCommand}"
                                ToolTip="Добавить исполняемый файл вручную">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Добавить .exe" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="5,6,11,6" />
                        <Button Style="{StaticResource IconActionButton}" Click="OnSelectionMenuClick"
                                ToolTip="Массовый выбор приложений">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Выбор" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                           VerticalAlignment="Center" Margin="7,0,0,0" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Выбрать видимые" Command="{Binding SelectVisibleCommand}" />
                                    <MenuItem Header="Снять видимые" Command="{Binding DeselectVisibleCommand}" />
                                    <MenuItem Header="Инвертировать выбранные" Command="{Binding InvertVisibleCommand}" />
                                    <Separator />
                                    <MenuItem Header="Снять всё" Command="{Binding ClearSelectionCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <CheckBox Grid.Column="1" Content="Системные приложения" VerticalAlignment="Center"
                              IsChecked="{Binding ShowSystemApps, Mode=TwoWay}"
                              ToolTip="Показать пакеты Store и системные процессы Windows" />
                </Grid>
            </Grid>

            <!-- Список -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,12">
                <Grid>
                    <ListBox ItemsSource="{Binding Apps}" ItemContainerStyle="{StaticResource AppRow}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="Список приложений">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent" MouseLeftButtonUp="OnRowClick">
                                    <Grid.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Открыть расположение файла" Click="OnOpenLocationClick" />
                                            <MenuItem Header="Скопировать путь" Click="OnCopyPathClick" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding Name}" />

                                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8" Margin="12,0,0,0"
                                            Background="{StaticResource SurfaceAltBrush}" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" Width="22" Height="22"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PathText}" Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="11"
                                                   ToolTip="{Binding PathText}" />
                                    </StackPanel>

                                    <Border Grid.Column="3" Style="{StaticResource Pill}" VerticalAlignment="Center"
                                            Margin="10,0,0,0" Padding="8,2"
                                            Background="{StaticResource SuccessSoftBrush}"
                                            BorderBrush="{StaticResource SuccessSoftBorderBrush}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="запущено" FontSize="10.5" Margin="6,0,0,0"
                                                       Foreground="{StaticResource SuccessBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Style="{StaticResource Chip}" VerticalAlignment="Center"
                                            Margin="8,0,0,0" Padding="7,2">
                                        <TextBlock Text="{Binding Source}" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Пустое состояние / сканирование -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                                Visibility="{Binding HasNoVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE71E;" FontFamily="{StaticResource IconFont}" FontSize="28"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Ничего не найдено" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="Измените фильтры или нажмите «Обновить», чтобы найти программы"
                                   Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="#E610131A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="22,16">
                            <StackPanel>
                                <ProgressBar IsIndeterminate="True" Width="180" Height="3" Foreground="{StaticResource AccentBrush}"
                                             Background="{StaticResource SurfaceAltBrush}" BorderThickness="0" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижняя панель применения -->
        <Border Grid.Row="1" Background="{StaticResource BgRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="30,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Pill}" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center"
                        Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningSoftBorderBrush}"
                        Visibility="{Binding Dirty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Есть несохранённые изменения" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Отменить" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                            Command="{Binding RevertCommand}"
                            Visibility="{Binding Dirty, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Отменить несохранённые изменения" />
                    <Button Style="{StaticResource PrimaryButton}" Padding="20,9"
                            ToolTip="Сохранить список и режим, пересобрать конфиг и перезапустить туннель"
                            Command="{Binding SaveCommand}" IsEnabled="{Binding Dirty, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Применить" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
