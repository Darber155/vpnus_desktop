<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Базовая палитра. Тёмная тема с холодным синим подтоном. -->
    <Color x:Key="BgColor">#FF07080C</Color>
    <Color x:Key="BgRaisedColor">#FF0B0D13</Color>
    <Color x:Key="SurfaceColor">#FF10131A</Color>
    <Color x:Key="SurfaceAltColor">#FF171B24</Color>
    <Color x:Key="SurfaceHoverColor">#FF1F2430</Color>
    <Color x:Key="BorderColor">#FF232834</Color>
    <Color x:Key="BorderStrongColor">#FF333B4B</Color>
    <Color x:Key="TextColor">#FFF4F6FB</Color>
    <Color x:Key="TextMutedColor">#FF8C93A6</Color>
    <Color x:Key="TextSubtleColor">#FF606879</Color>
    <Color x:Key="AccentColor">#FF6B8CFF</Color>
    <Color x:Key="AccentAltColor">#FF9A6BFF</Color>
    <Color x:Key="SuccessColor">#FF46E0A1</Color>
    <Color x:Key="DangerColor">#FFFF6470</Color>
    <Color x:Key="WarningColor">#FFFFB454</Color>
    <Color x:Key="ChipColor">#FF202633</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="BgRaisedBrush" Color="{StaticResource BgRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="{StaticResource TextSubtleColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentAltBrush" Color="{StaticResource AccentAltColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ChipBrush" Color="{StaticResource ChipColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#E607080C" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TabActiveBrush" Color="#FF1C2740" />

    <!-- Полупрозрачные подложки для бейджей, плашек и выделения -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#226B8CFF" />
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#666B8CFF" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2246E0A1" />
    <SolidColorBrush x:Key="SuccessSoftBorderBrush" Color="#5546E0A1" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#22FF6470" />
    <SolidColorBrush x:Key="DangerSoftBorderBrush" Color="#55FF6470" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1CFFB454" />
    <SolidColorBrush x:Key="WarningSoftBorderBrush" Color="#48FFB454" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentAltColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ConnectGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF46E0A1" Offset="0" />
        <GradientStop Color="#FF35B9D6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ConnectingGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFB454" Offset="0" />
        <GradientStop Color="#FFFF8A5C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ErrorGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF6470" Offset="0" />
        <GradientStop Color="#FFC2416B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DisconnectGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2A3040" Offset="0" />
        <GradientStop Color="#FF1E2330" Offset="1" />
    </LinearGradientBrush>

    <!-- Фон приложения и боковой панели: почти непрозрачный, с мягким градиентом -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#F50A0C12" Offset="0" />
        <GradientStop Color="#FA07080C" Offset="0.55" />
        <GradientStop Color="#FD080A10" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E60E1118" Offset="0" />
        <GradientStop Color="#F00A0C12" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0DFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.45" />
    </LinearGradientBrush>

    <!-- Мягкое свечение для «героя» на главной -->
    <RadialGradientBrush x:Key="HeroGlowBrush" Center="0.16,0.5" GradientOrigin="0.16,0.5" RadiusX="0.62" RadiusY="1.25">
        <GradientStop Color="#286B8CFF" Offset="0" />
        <GradientStop Color="#046B8CFF" Offset="0.62" />
        <GradientStop Color="#006B8CFF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="HeroGlowConnectedBrush" Center="0.16,0.5" GradientOrigin="0.16,0.5" RadiusX="0.62" RadiusY="1.25">
        <GradientStop Color="#2846E0A1" Offset="0" />
        <GradientStop Color="#0446E0A1" Offset="0.62" />
        <GradientStop Color="#0046E0A1" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="HeroGlowErrorBrush" Center="0.16,0.5" GradientOrigin="0.16,0.5" RadiusX="0.62" RadiusY="1.25">
        <GradientStop Color="#24FF6470" Offset="0" />
        <GradientStop Color="#04FF6470" Offset="0.62" />
        <GradientStop Color="#00FF6470" Offset="1" />
    </RadialGradientBrush>

</ResourceDictionary>
