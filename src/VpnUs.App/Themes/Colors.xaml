<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgColor">#FF0A0B0F</Color>
    <Color x:Key="SurfaceColor">#FF13151B</Color>
    <Color x:Key="SurfaceAltColor">#FF1A1D25</Color>
    <Color x:Key="SurfaceHoverColor">#FF222631</Color>
    <Color x:Key="BorderColor">#FF252A35</Color>
    <Color x:Key="BorderStrongColor">#FF323846</Color>
    <Color x:Key="TextColor">#FFF2F4F8</Color>
    <Color x:Key="TextMutedColor">#FF8A90A0</Color>
    <Color x:Key="AccentColor">#FF5B8CFF</Color>
    <Color x:Key="AccentAltColor">#FF7C5CFF</Color>
    <Color x:Key="SuccessColor">#FF3DDC97</Color>
    <Color x:Key="DangerColor">#FFFF5C6C</Color>
    <Color x:Key="WarningColor">#FFFFB020</Color>
    <Color x:Key="ChipColor">#FF232833</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentAltBrush" Color="{StaticResource AccentAltColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ChipBrush" Color="{StaticResource ChipColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#E60A0B0F" />

    <!-- Полупрозрачные подложки для бейджей, плашек и выделения -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F5B8CFF" />
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#665B8CFF" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F3DDC97" />
    <SolidColorBrush x:Key="SuccessSoftBorderBrush" Color="#553DDC97" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FFF5C6C" />
    <SolidColorBrush x:Key="DangerSoftBorderBrush" Color="#55FF5C6C" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#18FFB020" />
    <SolidColorBrush x:Key="WarningSoftBorderBrush" Color="#44FFB020" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentAltColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ConnectGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3DDC97" Offset="0" />
        <GradientStop Color="#FF3DB3DC" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ConnectingGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFB020" Offset="0" />
        <GradientStop Color="#FFFF7A45" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ErrorGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF5C6C" Offset="0" />
        <GradientStop Color="#FFC2416B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DisconnectGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2A3040" Offset="0" />
        <GradientStop Color="#FF1E2330" Offset="1" />
    </LinearGradientBrush>

    <!-- Мягкое свечение для «героя» на главной -->
    <RadialGradientBrush x:Key="HeroGlowBrush" Center="0.18,0.5" GradientOrigin="0.18,0.5" RadiusX="0.6" RadiusY="1.2">
        <GradientStop Color="#245B8CFF" Offset="0" />
        <GradientStop Color="#005B8CFF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="HeroGlowConnectedBrush" Center="0.18,0.5" GradientOrigin="0.18,0.5" RadiusX="0.6" RadiusY="1.2">
        <GradientStop Color="#243DDC97" Offset="0" />
        <GradientStop Color="#003DDC97" Offset="1" />
    </RadialGradientBrush>

</ResourceDictionary>
